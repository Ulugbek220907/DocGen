{
  "name": "docgen-app",
  "version": "1.0.0",
  "description": "Generate PDF, DOCX, and XLSX documents from plain-language descriptions via an AI chat interface.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleRelease bundleRelease",
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome-team/capacitor-file-opener": "^8.0.5",
    "@capgo/capacitor-social-login": "^8.5.11",
    "sharp": "^0.35.4"
  }
