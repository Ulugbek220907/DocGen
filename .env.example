# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string.
# Local dev example:  postgresql://postgres:password@localhost:5432/docgen
# Render:              Render provides this automatically once you attach a
#                       Postgres instance to this web service — copy it from
#                       the Postgres instance's "Connect" tab into this
#                       service's Environment settings.
DATABASE_URL=postgresql://user:password@localhost:5432/docgen

# Any long, random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Render sets this automatically; only needed locally if you want to test
# production-mode SSL behavior.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Password reset emails
# ---------------------------------------------------------------------------
# Any SMTP provider works. Without these set, forgot-password still "works"
# (the account, if it exists, gets a token) but the reset link is only
# printed to the server log instead of emailed — fine for local dev, not for
# production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DocGen AI <no-reply@yourdomain.com>

# ---------------------------------------------------------------------------
# App URL
# ---------------------------------------------------------------------------
# The public address of this server, used in password-reset emails and as
# the payment return URL. On Render, RENDER_EXTERNAL_URL is used if unset.
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI generation (one server-side key; usage is metered per user plan)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat API works. Defaults are for DeepSeek:
# create a key at https://platform.deepseek.com/api_keys and keep the
# account topped up (Billing) — requests fail with "out of credit" at $0.
AI_API_KEY=sk-replace_me
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Set to false if you switch to a model that can't read images.
AI_VISION=true

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# The OAuth "Web application" client ID from Google Cloud Console >
# APIs & Services > Credentials (ends in .apps.googleusercontent.com).
# The Android app uses this same Web client ID; additionally create an
# "Android" OAuth client there with package com.docgen.app and the SHA-1
# of every signing key (upload key + Play app signing key).
# Several IDs can be given comma-separated; the first is shown to the app.
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# Payments — worldwide (Paddle)
# ---------------------------------------------------------------------------
# Paddle is a Merchant of Record: it handles global card payments, VAT/tax
# compliance, and payout, which sidesteps Stripe's country-restricted
# merchant onboarding (Uzbekistan isn't a supported Stripe country). Create
# an account at https://paddle.com, add a "Pro" recurring price, and a
# webhook destination pointed at https://<your-domain>/webhooks/paddle.

# Client-side token from Paddle > Developer Tools > Authentication
# (safe to expose to the browser — it's not a secret).
PADDLE_CLIENT_TOKEN=

# The price id for your Pro subscription (Paddle > Catalog > Prices).
PADDLE_PRICE_ID=

# The signing secret for the webhook destination above (Paddle > Developer
# Tools > Notifications) — used to verify the Paddle-Signature header.
PADDLE_WEBHOOK_SECRET=

# Set to "sandbox" while testing against a Paddle Sandbox account; leave
# unset/blank in production.
PADDLE_ENVIRONMENT=

# Server-side API key (Paddle > Developer Tools > Authentication), only used
# to cancel a subscription immediately when a user deletes their account.
PADDLE_API_KEY=

# ---------------------------------------------------------------------------
# Payments — Uzbekistan (Payme + Click)
# ---------------------------------------------------------------------------
# UzCard/Humo — the majority of local cards — don't route through Paddle at
# all, so Payme and Click (the two dominant local processors) are wired up
# separately. Both require a registered Uzbekistan legal entity/individual
# entrepreneur account with the provider; register at
# https://business.payme.uz and https://merchant.click.uz.

# Payme: Merchant API key (Payme dashboard > Settings > Merchant API), used
# to authenticate their callbacks to /webhooks/payme (HTTP Basic Auth,
# username "Paycom"). PAYME_MERCHANT_ID is the id used to build the
# checkout URL client-side (Payme dashboard > your merchant > id).
# In the Payme cabinet, set the account field to "order_id" and the
# endpoint URL to https://<your-domain>/webhooks/payme.
PAYME_MERCHANT_ID=
PAYME_KEY=
# Use https://test.paycom.uz while testing in Payme's sandbox.
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Click: service/merchant ids build the checkout URL; the secret key signs
# their callbacks to /webhooks/click/prepare and /complete. All three are
# in the Click merchant cabinet.
# Prepare URL: https://<your-domain>/webhooks/click/prepare
# Complete URL: https://<your-domain>/webhooks/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
