# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string.
# Local dev example:  postgresql://postgres:password@localhost:5432/docgen
# Render:              Render provides this automatically once you attach a
#                       Postgres instance to this web service — copy it from
#                       the Postgres instance's "Connect" tab into this
#                       service's Environment settings.
DATABASE_URL=postgresql://user:password@localhost:5432/docgen

# Any long, random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Render sets this automatically; only needed locally if you want to test
# production-mode SSL behavior.
NODE_ENV=development
